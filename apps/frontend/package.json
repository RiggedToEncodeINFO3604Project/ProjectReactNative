{
  "name": "@skeduleit/frontend",
  "private": true,
  "license": "0BSD",
  "main": "index.js",
  "version": "54.0.35",
  "expo": {
    "install": {
      "exclude": [
        "expo-modules-autolinking"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@google/generative-ai"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "build": "node ../../node_modules/expo/bin/cli export --platform web",
    "start": "node ../../node_modules/expo/bin/cli start",
    "start:clear": "node ../../node_modules/expo/bin/cli start --clear",
    "reset-project": "node ../../scripts/reset-project.js",
    "android": "node ../../node_modules/expo/bin/cli start --android",
    "ios": "node ../../node_modules/expo/bin/cli start --ios",
    "web": "node ../../node_modules/expo/bin/cli start --web",
    "build:web": "node ../../node_modules/expo/bin/cli export --platform web",
    "serve": "node server.js",
    "lint": "node ../../node_modules/expo/bin/cli lint",
    "test": "node ../../node_modules/jest/bin/jest.js",
    "test:snapshot": "node ../../node_modules/jest/bin/jest.js --testPathPattern=__tests__/snapshot",
    "test:watch": "node ../../node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.14.10",
    "axios": "^1.7.9",
    "client-only": "^0.0.1",
    "event-target-shim": "^5.0.1",
    "expo": "~54.0.10",
    "expo-asset": "~12.0.12",
    "expo-calendar": "~15.0.8",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.7",
    "express": "^4.18.2",
    "firebase": "^10.14.1",
    "generator-function": "^2.0.1",
    "http-errors": "^2.0.1",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^2.0.6",
    "invariant": "^2.2.4",
    "jest-expo": "~54.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-fast-compare": "^3.2.2",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "set-function-length": "^1.2.2",
    "shallowequal": "^1.1.0",
    "statuses": "^2.0.2",
    "toidentifier": "^1.0.1",
    "vaul": "^1.1.2",
    "whatwg-url-without-unicode": "8.0.0-3"
  },
  "devDependencies": {
    "@eslint/plugin-kit": "^0.7.1",
    "@expo/cli": "^54.0.23",
    "@expo/fingerprint": "0.15.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-jest": "^30.3.0",
    "babel-preset-expo": "~54.0.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-visitor-keys": "^5.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
