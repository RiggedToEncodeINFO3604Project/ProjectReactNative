{
  "name": "skeduleit-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/frontend"
  ],
  "devDependencies": {
    "expo-modules-autolinking": "3.0.24",
    "expo-modules-core": "3.0.29"
  },
  "scripts": {
    "start": "npm run start --workspace apps/frontend",
    "frontend": "npm run start --workspace apps/frontend",
    "frontend:clear": "npm run start:clear --workspace apps/frontend",
    "android": "npm run android --workspace apps/frontend",
    "ios": "npm run ios --workspace apps/frontend",
    "web": "npm run web --workspace apps/frontend",
    "build:web": "npm run build:web --workspace apps/frontend",
    "serve": "npm run serve --workspace apps/frontend",
    "lint": "npm run lint --workspace apps/frontend",
    "test": "npm run test:frontend && npm run test:api && npm run test:rag",
    "test:frontend": "npm run test --workspace apps/frontend",
    "test:frontend:snapshot": "npm run test:snapshot --workspace apps/frontend",
    "test:api": "node scripts/run-python-tests.js apps/api",
    "test:rag": "node scripts/run-python-tests.js apps/rag-server"
  }
}
