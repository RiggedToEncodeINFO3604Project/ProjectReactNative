{
  "name": "skeduleit-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/expo-frontend"
  ],
  "devDependencies": {
    "eslint-scope": "^8.4.0",
    "expo-modules-autolinking": "3.0.24",
    "expo-modules-core": "3.0.29"
  },
  "scripts": {
    "start": "npm run start --workspace apps/expo-frontend",
    "frontend": "npm run start --workspace apps/expo-frontend",
    "frontend:clear": "npm run start:clear --workspace apps/expo-frontend",
    "android": "npm run android --workspace apps/expo-frontend",
    "ios": "npm run ios --workspace apps/expo-frontend",
    "web": "npm run web --workspace apps/expo-frontend",
    "build:web": "npm run build:web --workspace apps/expo-frontend",
    "lint": "npm run lint --workspace apps/expo-frontend",
    "test": "npm run test:frontend && npm run test:scheduling && npm run test:messaging && npm run test:snapshot && npm run test:rag",
    "test:frontend": "npm run test --workspace apps/expo-frontend",
    "test:frontend:snapshot": "npm run test:snapshot --workspace apps/expo-frontend",
    "test:scheduling": "py -3 -m unittest discover -s apps/scheduling-service/tests -p test_*.py",
    "test:messaging": "py -3 -m unittest discover -s apps/messaging-service/tests -p test_*.py",
    "test:snapshot": "py -3 -m unittest discover -s apps/snapshot-service/tests -p test_*.py",
    "test:rag": "py -3 -m unittest discover -s apps/rag-service/tests -p test_*.py"
  }
}
